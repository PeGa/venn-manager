# Flask session secret. Must be random, at least 32 bytes.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# SQLAlchemy connection string.
# SQLite (development): sqlite:///venn_manager.db
# PostgreSQL (production): postgresql://user:password@host:5432/venn_manager
DATABASE_URL=sqlite:///venn_manager.db

# Flask environment: development or production
FLASK_ENV=development

# First-run seed admin credentials.
# The seeded admin account will have must_change_password=True.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
