# Copy to `.env` for local development. Exported variables always win over this file.

# SQLAlchemy connection string. SQLite for development, PostgreSQL-compatible in production.
DATABASE_URL=sqlite:///venn_manager.db

# `development` or `production`. Production sets the Secure flag on the session cookie.
APP_ENV=development

# First-run admin, created by the initial migration. Must set a password at first sign-in.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin

# IANA time zone the household starts with. Decides when months begin and end.
DEFAULT_TIMEZONE=UTC

# Directory of the built frontend (frontend/dist). When set, the API serves it too,
# so one server answers both. Leave unset in development: Vite serves the frontend.
# FRONTEND_DIST=../frontend/dist
