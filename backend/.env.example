# Venn Manager — backend environment template.
# Copy to `.env` for local development. `.env` is gitignored; never commit it.
# Every value below is read from the environment. Nothing is hardcoded.

# Flask session signing key. Must be random and at least 32 bytes.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotating this value invalidates every existing session.
SECRET_KEY=

# SQLAlchemy connection string.
# SQLite for development, PostgreSQL-compatible for production.
DATABASE_URL=sqlite:///venn_manager.db

# Deployment environment: `development` or `production`.
# `production` turns on the Secure session cookie flag, which requires HTTPS.
FLASK_ENV=development

# First-run seed credentials, consumed only by the initial migration
# (CONTRACTS/BACKEND.md § 4.1). The seeded admin is forced to change this
# password at first login.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
