{
  "name": "venn-manager-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Venn Manager web client. Behaviour: CONTRACTS/FRONTEND.md.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
