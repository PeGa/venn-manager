    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-solid": "0.18.0",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.3"
